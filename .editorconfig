# EcoHabit EditorConfig

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{dart,yaml,yml,json}]
indent_size = 2

[*.{ts,js}]
indent_size = 2

[*.{py}]
indent_size = 4

[Makefile]
indent_style = tab
