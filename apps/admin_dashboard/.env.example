# EcoHabit Admin Dashboard — environment variables
# Copy to `.env.local` and fill in real values.

# Backend API (already includes the global `/api/v1` prefix)
NEXT_PUBLIC_API_BASE_URL=https://eco-habbit.onrender.com/api/v1

# Firebase web app config (Firebase Console -> Project Settings -> Your apps -> Web app)
# 1. Register a web app in the echo-habbit Firebase project
# 2. Enable Google Sign-In (Authentication -> Sign-in method)
# 3. Copy these values from the web app's config snippet
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=echo-habbit.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=echo-habbit
NEXT_PUBLIC_FIREBASE_APP_ID=
